# Qwen3.8 Flash Next - experimental vLLM 0.34.0 baseline.
# Official ARM64 image, pinned by platform-specific digest.
# The v0.32 MAPFIX image is not modified.

FROM vllm/vllm-openai@sha256:e40eb98263fa13418dda684147d73e8ec4a2b0e056a37e955dc189cd1b11dd16

LABEL local.qwen38.version="v0.34.0"
LABEL local.qwen38.variant="fp8-hybrid-core"

COPY src/vllm_fp8_hybrid_v034.py \
     /opt/qwen38-v034/vllm_fp8_hybrid_v034.py

COPY src/install_v034_fp8_hook.py \
     /opt/qwen38-v034/install_v034_fp8_hook.py

RUN python3 /opt/qwen38-v034/install_v034_fp8_hook.py

ENV VLLM_FP8_HYBRID=1

# Other MAPFIX patches are deliberately excluded.
# PLE, FLA, MTP, YaRN, and QSA runtime compatibility
# must be evaluated independently before promotion.
